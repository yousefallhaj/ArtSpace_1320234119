<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F2E6D5"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingBottom="24dp">

        <TextView
            android:id="@+id/artworkCounter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="1 / 6"
            android:textSize="20sp"
            android:textColor="#292019" />

        <ImageView
            android:id="@+id/artworkImage"
            android:layout_width="match_parent"
            android:layout_height="320dp"
            android:layout_marginTop="20dp"
            android:background="#FFFFFF"
            android:padding="24dp"
            android:elevation="6dp"
            android:src="@drawable/artwork_1"
            android:scaleType="fitCenter"
            android:contentDescription="Displayed artwork" />

        <LinearLayout
            android:id="@+id/artworkInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="vertical"
            android:background="#F7EBDD"
            android:padding="16dp">

            <TextView
                android:id="@+id/artworkTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Irises"
                android:textSize="26sp"
                android:textColor="#292019" />

            <TextView
                android:id="@+id/artworkArtist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Vincent van Gogh (1889)"
                android:textSize="16sp"
                android:textColor="#292019" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/navigationButtons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/previousButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:minHeight="48dp"
                android:text="Previous"
                android:textAllCaps="false"
                android:textColor="@color/button_text_color"
                app:backgroundTint="@color/button_background_color" />

            <Button
                android:id="@+id/nextButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:minHeight="48dp"
                android:text="Next"
                android:textAllCaps="false"
                android:textColor="@color/button_text_color"
                app:backgroundTint="@color/button_background_color" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>
