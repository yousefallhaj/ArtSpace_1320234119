<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F2E6D5"
    tools:context=".ArtworkDetailsActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp">

        <ImageView
            android:id="@+id/detailsImage"
            android:layout_width="180dp"
            android:layout_height="220dp"
            android:layout_marginTop="24dp"
            android:background="#FFFFFF"
            android:padding="16dp"
            android:elevation="6dp"
            android:scaleType="fitCenter"
            android:contentDescription="Selected artwork"
            tools:src="@drawable/artwork_1" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="vertical"
            android:background="#F7EBDD"
            android:padding="16dp">

            <TextView
                android:id="@+id/detailsTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="24sp"
                android:textColor="#292019"
                tools:text="Irises" />

            <TextView
                android:id="@+id/detailsText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textSize="16sp"
                android:textColor="#292019"
                tools:text="Vincent van Gogh (1889)" />

        </LinearLayout>

        <Button
            android:id="@+id/websiteButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="24dp"
            android:text="Visit Website"
            android:textSize="18sp"
            android:textAllCaps="false"
            android:textColor="@color/button_text_color"
            app:backgroundTint="@color/button_background_color" />

        <Button
            android:id="@+id/backButton"
            android:layout_width="160dp"
            android:layout_height="48dp"
            android:layout_marginTop="16dp"
            android:text="Back"
            android:textAllCaps="false"
            android:textColor="@color/button_text_color"
            android:textSize="16sp"
            app:backgroundTint="@color/button_background_color" />

    </LinearLayout>

</ScrollView>